{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linhkien",
  "main": "backend/src/index.ts",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],

  // run_worker_first la BAT BUOC - thieu no thi request navigate that (Sec-Fetch-Mode: navigate) se
  // bi Workers Static Assets SPA fallback chan truoc khi toi duoc Worker, curl se KHONG tai hien loi
  // nay. Xem CLAUDE.md he goc, bai hoc nay ap dung y het cho he moi. KHONG xoa dong nay.
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // database_id la PLACEHOLDER - dien sau khi chay "wrangler d1 create" that (xem DEPLOY.md buoc 2).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dat-mua-linh-kien-db",
      "database_id": "4ff72f29-e611-4618-afcc-5c364547bc23",
      "migrations_dir": "migrations"
    }
  ],

  // Them 2026-08-28 - dong bo danh ba KTV/danh muc linh kien sang he DVBH goc moi dau gio (xem
  // backend/src/lib/dvbhSyncClient.ts, index.ts `scheduled()`). Day la cron DUY NHAT cua he nay.
  "triggers": { "crons": ["0 * * * *"] },
  // Khong co "r2_buckets" - khong dung R2 (xem CLAUDE.md).

  // Them 2026-08-26 (debug production case-lookup): fetch() thang toi URL "*.workers.dev" cua 1
  // Worker KHAC bi Cloudflare chan (error code 1042, chong SSRF) khi ben goi cung la 1 Worker - chi
  // xay ra vi ca "linhkien" lan "dvbh" (he DVBH goc) deu la Cloudflare Worker, cung 1 tai khoan. Dung
  // Service Binding (dispatch noi bo qua Cloudflare, khong qua fetch() mang that) de vong qua han che
  // nay - "service" la TEN SCRIPT that cua Worker dvbh (suy truc tiep tu URL "dvbh.dichvu3t.workers.dev",
  // dung dinh dang "<ten-script>.<subdomain-tai-khoan>.workers.dev" cua Cloudflare).
  // "remote": true - BAT BUOC de "npm run dev:worker" (local) cung dispatch toi ban DA DEPLOY that cua
  // dvbh thay vi tim 1 "wrangler dev" khac dang chay local cho service "dvbh" (khong ton tai, se loi).
  //
  // Them 04/09/2026: "SUACHUA_SYNC_SERVICE" - dich day THU 2 cho dvbhSyncClient.ts (Worker doc lap
  // "suachua", module Sua chua bao hanh - xem CLAUDE.md repo "gui-bao-hanh-linh-kien" muc "Chot 5 cau
  // hoi mo..."). Cung ly do Service Binding nhu CASE_LOOKUP_SERVICE o tren (cung 1 tai khoan
  // Cloudflare, fetch() thang bi chan loi 1042). "suachua" da online that (xac nhan 04/09/2026) nhung
  // hien la ban rong/placeholder - binding nay AN TOAN khai bao truoc, chi thuc su co tac dung sau khi
  // repo "gui-bao-hanh-linh-kien" duoc deploy that len dung Worker "suachua".
  // Them 2026-09-07: "KHOVAN_SYNC_SERVICE" - dich day THU 3 cho dvbhSyncClient.ts (Worker doc lap
  // "khovan", he Quan ly hang ve kho). Cung 1 tai khoan Cloudflare nen dung Service Binding, ly do
  // giong het 2 dich tren.
  "services": [
    { "binding": "CASE_LOOKUP_SERVICE", "service": "dvbh", "remote": true },
    { "binding": "SUACHUA_SYNC_SERVICE", "service": "suachua", "remote": true },
    { "binding": "KHOVAN_SYNC_SERVICE", "service": "khovan", "remote": true }
  ],

  "vars": {
    "BOOTSTRAP_ADMIN_EMAIL": "smarttrade.vp@gmail.com",
    "GOOGLE_REDIRECT_URI": "https://linhkien.dichvu3t.workers.dev/api/auth/callback",
    "FRONTEND_URL": "https://linhkien.dichvu3t.workers.dev",
    // Diem noi DUY NHAT toi he DVBH goc (chi tra cuu case theo ID, khong ghi) - xem
    // lib/caseLookupClient.ts + backend/src/routes/partnerApi.ts cua he goc.
    "CASE_LOOKUP_BASE_URL": "https://dvbh.dichvu3t.workers.dev",
    // Diem noi toi Worker "suachua" (module Sua chua bao hanh, doc lap - xem SUACHUA_SYNC_SERVICE o
    // tren). Chi dung de GHI (dong bo day KTV/linh kien/Khu vuc), khong doc gi tu day.
    "SUACHUA_SYNC_BASE_URL": "https://suachua.dichvu3t.workers.dev",
    // Diem noi toi Worker "khovan" (he Quan ly hang ve kho, doc lap - xem KHOVAN_SYNC_SERVICE o tren).
    // Chi dung de GHI (dong bo day danh sach KTV lam "Nguoi gui hang"), khong doc gi tu day.
    "KHOVAN_SYNC_BASE_URL": "https://khovan.dichvu3t.workers.dev",
    // Web Push (them 2026-08-26, xem backend/src/lib/webPush.ts) - VAPID_SERVER_PUBLIC_KEY KHONG
    // nhay cam (day la khoa cong khai frontend can de subscribe), an toan de trong "vars". Rieng
    // VAPID_SERVER_PRIVATE_KEY dat qua "wrangler secret put" (xem duoi).
    "VAPID_SUBJECT": "mailto:smarttrade.vp@gmail.com",
    "VAPID_SERVER_PUBLIC_KEY": "BH76Ljxdui9LYP3uAT9hmacV8Phe-y3UzNQHQVHOKqcn_57Y6si5QxH2QxfAmr6W6wmZiMpR8eweAvImDgRRxSI"
  }

  // Cac gia tri NHAY CAM (khong dat trong "vars" - dat qua "wrangler secret put", xem DEPLOY.md):
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, SESSION_SECRET, CASE_LOOKUP_API_KEY,
  // DVBH_SYNC_API_KEY, VAPID_SERVER_PRIVATE_KEY.
  // Them 04/09/2026: SUACHUA_SYNC_API_KEY - PHAI dat gia tri GIONG HET secret
  // "LINHKIEN_SYNC_API_KEY" ben repo "gui-bao-hanh-linh-kien" (Worker "suachua"), vi day la quan he
  // xac thuc 1-1 dung 1 secret dung chung (khong phai bang partner_api_keys nhieu-key) - xem
  // backend/src/routes/sync.ts cua repo do.
  // Them 2026-09-07: KHOVAN_SYNC_API_KEY - gia tri = api_key cua dong external_systems da tao san
  // trong khovan cho "linh-kien-app" (Settings > He thong lien quan ben khovan, code=linh_kien_app),
  // dung header "X-Api-Key" (khac quan he 1-1 nhu suachua - khovan dung bang external_systems nhieu-key).
  // Google Drive (anh linh kien/PXK/tra hang) KHONG can them bien env nao - dung chung
  // GOOGLE_CLIENT_ID/SECRET o tren qua co che OAuth uy quyen 1 tai khoan that, luu refresh token
  // trong bang google_drive_oauth (xem lib/googleDrive.ts) - da bo Service Account 2026-08-25.
}
